# Copy to .env and fill in your values.

# Execute-only key for Playwright/Eyes capture. Same name as the GitHub
# Actions secret used by the visual test step.
APPLITOOLS_API_KEY=your_applitools_api_key_here

# Read-scoped key for MCP inspect (eyes_review_progress). Generate under
# Applitools Admin → Teams → API Keys with permission "read". Use the same
# value as the GitHub Actions secret APPLITOOLS_READ_KEY.
APPLITOOLS_READ_KEY=your_applitools_read_key_here

# Write-scoped key for MCP resolve (regions, accept/reject). Same name as
# the GitHub Actions secret APPLITOOLS_WRITE_KEY. CI still must not call
# eyes_resolve_save unless a separate gated workflow is added.
APPLITOOLS_WRITE_KEY=your_applitools_write_key_here
