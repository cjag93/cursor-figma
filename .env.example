# Copy to .env and fill in your values.
# Use the same APPLITOOLS_API_KEY as a GitHub Actions secret for CI.

APPLITOOLS_API_KEY=your_applitools_api_key_here

# Required for Figma baseline linking (local runs only).
# Create at https://developers.figma.com/docs/rest-api/authentication/
FIGMA_ACCESS_TOKEN=your_figma_access_token_here
